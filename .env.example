# --- MotherDuck ---
# Create a token at https://motherduck.com/ (Settings -> Access Tokens)
MOTHERDUCK_TOKEN=
# Database name inside your MotherDuck account to load data into.
MOTHERDUCK_DATABASE=marketstack_test

# --- Market data: marketstack (via apilayer) ---
# Sign up at https://marketstack.com/ and get an access key from your
# apilayer dashboard. API_URL should point at the full /v2/eod endpoint,
# e.g. https://api.apilayer.net/marketstack/v2/eod - see
# pipeline/extract/marketstack.py.
API_URL=
API_ACCESS_KEY=
