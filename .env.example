# --- MotherDuck ---
# Create a token at https://motherduck.com/ (Settings -> Access Tokens)
MOTHERDUCK_TOKEN=
# Database name inside your MotherDuck account to load data into.
MOTHERDUCK_DATABASE=dives_and_flights

# --- Flights: AviationStack (free tier) ---
# Sign up for a free key at https://aviationstack.com/signup/free
# Note: the free plan only supports HTTP (not HTTPS) and a limited
# monthly request quota - see pipeline/extract/flights.py.
AVIATIONSTACK_API_KEY=

# --- Dives: generic REST API placeholder ---
# Point these at your actual dive-log source (a dive computer's cloud
# service, a personal logging API, etc). See pipeline/extract/dives.py
# to adjust the request/response shape to match your real API.
DIVE_API_BASE_URL=
DIVE_API_KEY=
