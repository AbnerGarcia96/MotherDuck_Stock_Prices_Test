{
  "name": "DuckDB Python (uv)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  },
  "postCreateCommand": "uv sync && duckdb --version && uv run python -c \"import duckdb; print('duckdb', duckdb.__version__)\"",
  "remoteUser": "vscode"
}
